<script>
  (function () {
    var buttons = document.querySelectorAll('.resource-tabs__btn');
    var panels = document.querySelectorAll('.resource-panel');

    function showPanel(id) {
      panels.forEach(function (p) { p.hidden = p.id !== id; });
      buttons.forEach(function (b) {
        b.setAttribute('aria-selected', b.dataset.tab === id ? 'true' : 'false');
      });
    }

    // Open the tab containing the hash target, then scroll to it
    function openFromHash() {
      var target = location.hash ? document.getElementById(location.hash.slice(1)) : null;
      var panel = target ? target.closest('.resource-panel') : null;
      showPanel(panel ? panel.id : 'start-here');
      if (target && target !== panel) target.scrollIntoView();
    }

    buttons.forEach(function (b) {
      b.addEventListener('click', function () {
        history.replaceState(null, '', '#' + b.dataset.tab);
        showPanel(b.dataset.tab);
      });
    });

    window.addEventListener('hashchange', openFromHash);
    openFromHash();
  })();
</script>
